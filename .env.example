# 复制为 .env 后填写。不要把 .env 提交到仓库。
# 任何 OpenAI 兼容服务都可以：DeepSeek / OpenAI / Moonshot / vLLM / LM Studio ...
PET_BASE_URL=https://api.deepseek.com/v1
PET_MODEL=deepseek-chat
PET_API_KEY=sk-your-key-here

# 可选：抽取记忆时换一个更便宜的模型（留空则复用 PET_MODEL）
PET_EXTRACT_MODEL=

# 本地 Ollama 示例（无需 key，base_url 含 localhost 即可）：
# PET_BASE_URL=http://localhost:11434/v1
# PET_MODEL=qwen2.5:7b

# 强制离线，不发起任何网络请求
# PET_MOCK=1

# 自定义数据目录（默认 ./data）
# LONGMEM_PET_HOME=D:\pet-data
